{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.associations": {
      "*.gll": "gulliver"
    },
    "[gulliver]": {
      "editor.defaultFormatter": null,
      "editor.formatOnSave": false,
      "editor.tabSize": 2,
      "editor.insertSpaces": true,
      "editor.autoIndent": "full",
      "editor.wordWrap": "on"
    }
  }
}
