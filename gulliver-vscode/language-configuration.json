{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  },
  "wordPattern": "(-?\\d*\\.?\\d+([eE][+-]?\\d+)?)|([a-zA-Z_$][a-zA-Z0-9_$]*)",
  "indentationRules": {
    "increaseIndentPattern": "^((?!//|/\\*|\\*/).)*[{\\[]\\s*$",
    "decreaseIndentPattern": "^((?!.*?\\/\\*).*\\*/)?(^|.*\\s)[}\\]].*$"
  }
}
